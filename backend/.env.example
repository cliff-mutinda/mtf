FLASK_ENV=development
FLASK_DEBUG=true
PORT=5000
HOST=0.0.0.0
SECRET_KEY=your-secret-key-change-in-production

# Database Configuration (MySQL / MariaDB)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=contacts_db
DATABASE_USERNAME=root
DATABASE_PASSWORD=

# Initial Admin User (auto-seeded if users table is empty)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123

# Allowed Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173

# Safaricom Daraja M-Pesa Configuration (sandbox / production)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_BUSINESS_SHORT_CODE=174379
MPESA_ACCOUNT_REFERENCE=Cliff's Sharp Boy Association
MPESA_CALLBACK_URL=http://localhost:5000/api/mpesa/callback

# Safe Auto-Init Tables on Startup (true / false)
AUTO_INIT_DB=true
